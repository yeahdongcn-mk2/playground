{
  "name": "playground-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable web game shell with lazily loaded 2D games: Snake, Tetris, 2048 and Breakout (Phaser) plus Minesweeper (DOM).",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:webkit": "npm run build && playwright test --project=mobile-webkit",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "screenshots:webkit": "npm run build && node scripts/capture-screenshots.mjs --webkit",
    "screenshots:snake": "node scripts/capture-snake-screenshots.mjs",
    "screenshots:snake:webkit": "node scripts/capture-snake-screenshots.mjs --webkit",
    "screenshots:2048": "npm run build && node scripts/capture-2048-screenshots.mjs",
    "screenshots:2048:before": "node scripts/capture-2048-screenshots.mjs --before",
    "screenshots:2048:webkit": "npm run build && node scripts/capture-2048-screenshots.mjs --webkit",
    "screenshots:breakout": "npm run build && node scripts/capture-breakout-screenshots.mjs",
    "screenshots:breakout:before": "node scripts/capture-breakout-screenshots.mjs --before",
    "screenshots:breakout:webkit": "npm run build && node scripts/capture-breakout-screenshots.mjs --webkit",
    "screenshots:minesweeper": "npm run build && node scripts/capture-minesweeper-screenshots.mjs",
    "screenshots:minesweeper:webkit": "npm run build && node scripts/capture-minesweeper-screenshots.mjs --webkit",
    "screenshots:minesweeper:webkit-before": "node scripts/capture-minesweeper-screenshots.mjs --webkit --touch-before",
    "screenshots:minesweeper:touch-before": "node scripts/capture-minesweeper-screenshots.mjs --touch-before",
    "screenshots:minesweeper:narrow": "npm run build && node scripts/capture-minesweeper-screenshots.mjs --narrow",
    "screenshots:minesweeper:narrow-before": "node scripts/capture-minesweeper-screenshots.mjs --narrow-before",
    "screenshots:minesweeper:webkit-narrow": "npm run build && node scripts/capture-minesweeper-screenshots.mjs --webkit-narrow",
    "screenshots:minesweeper:webkit-narrow-before": "node scripts/capture-minesweeper-screenshots.mjs --webkit-narrow-before",
    "screenshots:minesweeper:min": "npm run build && node scripts/capture-minesweeper-screenshots.mjs --min",
    "screenshots:minesweeper:min-before": "node scripts/capture-minesweeper-screenshots.mjs --min-before",
    "screenshots:minesweeper:restart": "npm run build && node scripts/capture-minesweeper-screenshots.mjs --restart",
    "screenshots:minesweeper:restart-before": "node scripts/capture-minesweeper-screenshots.mjs --restart-before",
    "screenshots:minesweeper:short": "npm run build && node scripts/capture-minesweeper-screenshots.mjs --short",
    "screenshots:minesweeper:short-before": "node scripts/capture-minesweeper-screenshots.mjs --short-before",
    "screenshots:minesweeper:large": "npm run build && node scripts/capture-minesweeper-screenshots.mjs --large",
    "screenshots:minesweeper:large-before": "node scripts/capture-minesweeper-screenshots.mjs --large-before",
    "screenshots:minesweeper:scores": "npm run build && node scripts/capture-minesweeper-scores-screenshots.mjs",
    "screenshots:minesweeper:scores:webkit": "npm run build && node scripts/capture-minesweeper-scores-screenshots.mjs --webkit",
    "screenshots:minesweeper:scores-before": "node scripts/capture-minesweeper-scores-screenshots.mjs --before",
    "screenshots:minesweeper:scores-clear": "npm run build && node scripts/capture-minesweeper-scores-screenshots.mjs --clear",
    "screenshots:minesweeper:scores-clear-before": "node scripts/capture-minesweeper-scores-screenshots.mjs --before --clear",
    "screenshots:baseline": "node scripts/capture-baseline.mjs",
    "lint": "oxlint src tests && node scripts/check-boundaries.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "verify:screenshots:webkit": "node scripts/verify-screenshot-artifacts.mjs",
    "verify:screenshots:doc-dims": "node scripts/check-screenshot-doc-dims.mjs",
    "verify:doc-counts": "node scripts/check-doc-counts.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
