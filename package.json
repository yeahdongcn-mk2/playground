{
  "name": "playground-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable web game shell with lazily loaded 2D games: Snake, Tetris, 2048 and Breakout (Phaser) plus Minesweeper (DOM).",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "screenshots:snake": "node scripts/capture-snake-screenshots.mjs",
    "screenshots:2048": "npm run build && node scripts/capture-2048-screenshots.mjs",
    "screenshots:2048:before": "node scripts/capture-2048-screenshots.mjs --before",
    "screenshots:breakout": "npm run build && node scripts/capture-breakout-screenshots.mjs",
    "screenshots:breakout:before": "node scripts/capture-breakout-screenshots.mjs --before",
    "screenshots:minesweeper": "npm run build && node scripts/capture-minesweeper-screenshots.mjs",
    "screenshots:minesweeper:before": "node scripts/capture-minesweeper-screenshots.mjs --before",
    "screenshots:minesweeper:touch-before": "node scripts/capture-minesweeper-screenshots.mjs --touch-before",
    "screenshots:minesweeper:narrow": "npm run build && node scripts/capture-minesweeper-screenshots.mjs --narrow",
    "screenshots:minesweeper:narrow-before": "node scripts/capture-minesweeper-screenshots.mjs --narrow-before",
    "screenshots:baseline": "node scripts/capture-baseline.mjs",
    "lint": "oxlint src tests && node scripts/check-boundaries.mjs",
    "check:budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
